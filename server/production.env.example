# Copy to server/.env ON THE SERVER ONLY (never commit it). docker-compose already sets
# NODE_ENV=production, CORS_ORIGINS and TRUST_PROXY.

# Required — the API refuses to start in production without JWT_SECRET.
JWT_SECRET=<openssl rand -hex 48>
ADMIN_PASSWORD=<strong password for demo@globaltech.io, the owner login>

# MongoDB Atlas (allow the server's IP under Atlas -> Network Access)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=global_tech_crm

# Email (Gmail app password). IMAP reuses the same login.
SMTP_USER=<address>
SMTP_APP_PASSWORD=<16-char app password>
SMTP_FROM=<address>
SMTP_FROM_NAME=Time Global Tech

WHATSAPP_INTEGRATION_KEY=<random hex>
FRONTEND_URL=https://crm.tgailab.site
# PMCONNECT_SHARED_SECRET=<optional>
