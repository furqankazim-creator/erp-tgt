# Copy this file to .env and fill in real values. .env is gitignored.
#
# Gmail SMTP for "Send Report" emails (Reports page):
#   1. Turn on 2-Step Verification on the Google account you want to send from.
#   2. Google Account -> Security -> App Passwords -> generate one for "Mail".
#   3. Paste the 16-character app password below (not your normal Gmail password).
SMTP_USER=furqankazim6@gmail.com
SMTP_APP_PASSWORD=xdmcudygnrpqrukm
SMTP_FROM=furqankazim6@gmail.com
# Only override these if you're using a non-Gmail SMTP provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Backend API port. Defaults to 5000 if unset.
PORT=5052

# Email -> ERP intake: watches this same Gmail inbox for new mail and turns
# each one into an Inquiry automatically. Reuses SMTP_USER/SMTP_APP_PASSWORD
# above by default — only set these if you want a *different* mailbox
# watched than the one you send from.
# IMAP_USER=furqankazim6@gmail.com
# IMAP_APP_PASSWORD=xxxxxxxxxxxxxxxx
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# Also required once, in Gmail itself: Settings -> See all settings ->
# Forwarding and POP/IMAP -> Enable IMAP -> Save changes.

# WhatsApp -> ERP intake: shared secret the ChatApp backend sends (as the
# X-Integration-Key header) when it creates an Inquiry from a WhatsApp
# conversation via POST /api/integrations/whatsapp/inquiries. Must match the
# value ChatApp is configured with, or that route refuses every request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_INTEGRATION_KEY=

# --- Production hardening ---
# NODE_ENV=production
# JWT_SECRET=<long random string, e.g. openssl rand -hex 48>   (required in production)
# ADMIN_PASSWORD=<strong password for demo@globaltech.io, the owner login>
# CORS_ORIGINS=https://your-erp-domain.com
# PMCONNECT_SHARED_SECRET=<optional; the IDE extension sends it as X-PMConnect-Secret>
